# Copy to .env for LOCAL runs only. Never commit .env (see .gitignore).
# Production values live in Render Dashboard → Environment (see README §5).

# Comma-separated user keys the iOS app presents as `Authorization: Bearer <key>`.
# REQUIRED. Empty = server denies every request (fail-closed).
BACKEND_API_KEYS=dev-local-key-1

# Provider keys (server-side only — NEVER in the iOS app or Git).
# Leave a provider empty to disable it. At least one is required to answer.
GEMINI_API_KEY=
GROQ_API_KEY=

# Models (configurable because vendors rotate IDs; verify live IDs in console).
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_MODEL=llama-3.1-8b-instant

# Local LLM (Ollama, OpenAI-compatible). No key needed.
# Default pick for 8GB CPU laptops: qwen2.5:3b (Q4, ~2GB).
LOCAL_MODEL=qwen2.5:3b
LOCAL_BASE=http://localhost:11434/v1/chat/completions

# Shared hub stores (ecosystem sync). JSON files; survive restarts.
# Override per machine as needed (tests use temp files).
MEMORY_FILE=A:\ZYRAXIS-Server\hub\memory.json
TASKS_FILE=A:\ZYRAXIS-Server\hub\tasks.json

# Senses: vision model (Ollama), Vosk voice model dir, Ollama host.
OLLAMA_HOST=http://localhost:11434
VISION_MODEL=moondream
VOSK_MODEL_DIR=A:\ZYRAXIS-Server\models\vosk-model-small-en-us-0.15

# Order tried per request. First success wins; 429/5xx falls through.
# Local-first (private + free): local,gemini,groq
# Cloud-only (Render, no Ollama there): gemini,groq
PROVIDER_ORDER=local,gemini,groq

# Must match the iOS client's apiVersion ("v1" — BackendConfig.swift).
API_VERSION=v1

# Assistant personality prefix (client context is appended per request).
SYSTEM_PROMPT=You are ZYRAXIS, a concise futuristic AI assistant. Answer helpfully in plain text. Keep replies short unless asked for detail.

MAX_OUTPUT_TOKENS=1024
TEMPERATURE=0.7
